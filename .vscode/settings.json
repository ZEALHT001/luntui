{
  "cmake.cmakePath": "/opt/homebrew/bin/cmake",
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
  "cmake.configureSettings": {
    "CMAKE_MAKE_PROGRAM": "/opt/homebrew/bin/ninja"
  },
  "cmake.configureEnvironment": {
    "PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "cmake.buildEnvironment": {
    "PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "cmake.configureOnOpen": false,
  "cmake.useCMakePresets": "always",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.default.compilerPath": "/opt/homebrew/bin/arm-none-eabi-gcc",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/Debug",
    "--query-driver=/opt/homebrew/bin/arm-none-eabi-g*,/opt/homebrew/bin/arm-none-eabi-gcc*"
  ]
}
